#!/usr/bin/env bash
# Builds mustr and wraps it in a local macOS app bundle, so macOS gives it its name, its Dock icon,
# the mustr:// URL scheme, and system notifications (which need a bundle identifier).
#
#   script/mustr-bundle-mac            # debug build, then target/mustr-debug/mustr.app
#   script/mustr-bundle-mac --release  # release build, then target/mustr-release/mustr.app
#   script/mustr-bundle-mac --open     # also launches it
#
# The bundle is signed ad hoc, for this Mac only. It isn't notarized; that's packaging work.
# Debug builds read their assets from the checkout, which they find by walking up from the
# executable, so the bundle stays inside the checkout's target folder.

set -euo pipefail

cd "$(dirname "$0")/.."
root=$(pwd)

profile=debug
cargo_flags=()
open_after=false
for arg in "$@"; do
    case "$arg" in
        --release)
            profile=release
            cargo_flags+=(--release)
            ;;
        --open) open_after=true ;;
        *)
            echo "mustr-bundle-mac: unknown argument $arg" >&2
            exit 2
            ;;
    esac
done

if [[ "$(uname -s)" != Darwin ]]; then
    echo "mustr-bundle-mac: this builds a macOS app bundle; run it on a Mac" >&2
    exit 1
fi

# rustup's installer adds ~/.cargo/bin to new shells only, so look there too.
if ! command -v cargo >/dev/null && [[ -x "$HOME/.cargo/bin/cargo" ]]; then
    PATH="$HOME/.cargo/bin:$PATH"
fi
if ! command -v cargo >/dev/null; then
    cat >&2 <<'EOF'
mustr-bundle-mac: cargo isn't installed. Install Rust with rustup, then run this script again:

    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    . "$HOME/.cargo/env"

The first build installs the Rust version that rust-toolchain.toml pins.
EOF
    exit 1
fi

# Zed's editor builds tree-sitter with WebAssembly grammar support, whose build script (in
# wasmtime-c-api-impl) runs `cmake`. Find Homebrew's or CMake.app's when they aren't on PATH.
for dir in /opt/homebrew/bin /usr/local/bin /Applications/CMake.app/Contents/bin; do
    if ! command -v cmake >/dev/null && [[ -x "$dir/cmake" ]]; then
        PATH="$PATH:$dir"
    fi
done
if ! command -v cmake >/dev/null; then
    cat >&2 <<'EOF'
mustr-bundle-mac: cmake isn't installed. Install it, then run this script again:

    brew install cmake

Without Homebrew, download the macOS .dmg from https://cmake.org/download/ and drag
CMake into Applications; this script finds it there.
EOF
    exit 1
fi

cargo build -p mustr ${cargo_flags[@]+"${cargo_flags[@]}"}

target_dir=${CARGO_TARGET_DIR:-$root/target}
binary="$target_dir/$profile/mustr"
version=$(sed -n 's/^version = "\(.*\)"$/\1/p' mustr-crates/mustr/Cargo.toml | head -n 1)

app="$root/target/mustr-$profile/mustr.app"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
# A copy-on-write clone on APFS, so the large debug binary costs no time or space.
cp -c "$binary" "$app/Contents/MacOS/mustr" 2>/dev/null || cp "$binary" "$app/Contents/MacOS/mustr"
cp mustr-crates/mustr/resources/mustr.icns "$app/Contents/Resources/mustr.icns"

cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>mustr</string>
    <key>CFBundleExecutable</key>
    <string>mustr</string>
    <key>CFBundleIconFile</key>
    <string>mustr</string>
    <key>CFBundleIdentifier</key>
    <string>dev.mustr.mustr</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>mustr</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$version</string>
    <key>CFBundleVersion</key>
    <string>$version</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>mustr</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>mustr</string>
            </array>
        </dict>
    </array>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <key>LSMinimumSystemVersion</key>
    <string>10.15.7</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
</dict>
</plist>
PLIST

codesign --force --sign - --identifier dev.mustr.mustr "$app"

echo "Built $app"
if [[ "$open_after" == true ]]; then
    open "$app"
fi
