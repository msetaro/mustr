#!/usr/bin/env python3
"""Generate mustr's app icons from code.

Writes the SVG masters to mustr-crates/mustr/resources/icon/, then renders the PNG, ICNS and ICO
files the app and the bundles use. Rendering needs a headless Chrome or Chromium (set MUSTR_CHROME
to its path if it isn't on PATH) and Pillow.

The design: three chevrons pointing up, like a stack of diff lines. Two removed lines in red and an
added line in green, on a flat dark gray squircle.
"""

import math
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
RESOURCES = ROOT / "mustr-crates" / "mustr" / "resources"

BACKGROUND = "#1e1e1e"
GREEN = ("#6ee787", "#2ea043")
RED = ("#ffa198", "#e5534b")
# (apex y, gradient, opacity), bottom to top.
CHEVRONS = [(590, RED, 0.45), (450, RED, 0.85), (310, GREEN, 1.0)]

# macOS draws app icons on an 824-point body inside a 1024-point canvas. Linux and Windows icons
# fill more of the canvas, so their master scales the same art up.
MACOS_SCALE = 1.0
FULL_SCALE = 1.15

LINUX_SIZES = [16, 24, 32, 48, 64, 128, 256, 512]
ICO_SIZES = [16, 24, 32, 48, 64, 128, 256]
ICNS_SIZES = [16, 32, 64, 128, 256, 512, 1024]


def squircle_path(center=512.0, radius=412.0, exponent=5.0, steps=256):
    points = []
    for index in range(steps):
        angle = 2 * math.pi * index / steps
        cos, sin = math.cos(angle), math.sin(angle)
        x = center + radius * math.copysign(abs(cos) ** (2 / exponent), cos)
        y = center + radius * math.copysign(abs(sin) ** (2 / exponent), sin)
        points.append(f"{x:.1f},{y:.1f}")
    return "M" + " L".join(points) + " Z"


def icon_svg(scale):
    gradients = "".join(
        f'<linearGradient id="{name}" x1="0" y1="0" x2="0" y2="1">'
        f'<stop offset="0" stop-color="{top}"/><stop offset="1" stop-color="{bottom}"/>'
        "</linearGradient>"
        for name, (top, bottom) in (("green", GREEN), ("red", RED))
    )
    chevrons = "".join(
        f'<polyline points="300,{y + 150} 512,{y} 724,{y + 150}" fill="none" '
        f'stroke="url(#{"green" if colors == GREEN else "red"})" stroke-opacity="{opacity}" '
        'stroke-width="80" stroke-linecap="round" stroke-linejoin="round"/>'
        for y, colors, opacity in CHEVRONS
    )
    body = squircle_path()
    return (
        '<svg xmlns="http://www.w3.org/2000/svg" width="1024" height="1024" viewBox="0 0 1024 1024">'
        f"<defs>{gradients}</defs>"
        f'<g transform="translate(512 512) scale({scale}) translate(-512 -512)">'
        f'<path d="{body}" fill="{BACKGROUND}"/>'
        f'<path d="{body}" fill="none" stroke="#ffffff" stroke-opacity=".07" stroke-width="4"/>'
        f"{chevrons}</g></svg>\n"
    )


def find_chrome():
    configured = os.environ.get("MUSTR_CHROME")
    if configured:
        return configured
    for name in ("chrome-headless-shell", "chromium", "chromium-browser", "google-chrome"):
        path = shutil.which(name)
        if path:
            return path
    mac_chrome = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
    if os.path.exists(mac_chrome):
        return mac_chrome
    sys.exit("mustr-icons: no headless Chrome found; set MUSTR_CHROME to its path")


def render(chrome, svg_path, size, out_path, scratch):
    page = scratch / f"{svg_path.stem}-{size}.html"
    page.write_text(
        '<html><body style="margin:0;background:transparent">'
        f'<img src="{svg_path.as_uri()}" width="{size}" height="{size}"></body></html>'
    )
    out_path.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(
        [
            chrome,
            "--headless",
            "--no-sandbox",
            "--hide-scrollbars",
            "--force-device-scale-factor=1",
            "--default-background-color=00000000",
            f"--window-size={size},{size}",
            f"--screenshot={out_path}",
            page.as_uri(),
        ],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def main():
    from PIL import Image

    chrome = find_chrome()
    masters = RESOURCES / "icon"
    masters.mkdir(parents=True, exist_ok=True)
    macos_svg = masters / "mustr-macos.svg"
    full_svg = masters / "mustr.svg"
    macos_svg.write_text(icon_svg(MACOS_SCALE))
    full_svg.write_text(icon_svg(FULL_SCALE))

    with tempfile.TemporaryDirectory() as scratch_dir:
        scratch = Path(scratch_dir)

        def rendered(svg, size):
            path = scratch / f"{svg.stem}-{size}.png"
            if not path.exists():
                render(chrome, svg, size, path, scratch)
            return Image.open(path).convert("RGBA")

        # macOS: the bundle's PNGs (as Zed's bundle uses) and an ICNS.
        rendered(macos_svg, 512).save(RESOURCES / "app-icon.png")
        rendered(macos_svg, 1024).save(RESOURCES / "app-icon@2x.png")
        icns = [rendered(macos_svg, size) for size in ICNS_SIZES]
        icns[-1].save(RESOURCES / "mustr.icns", append_images=icns[:-1])

        # Linux: the freedesktop icon theme layout, named after the app ID.
        for size in LINUX_SIZES:
            out = RESOURCES / "linux" / "hicolor" / f"{size}x{size}" / "apps" / "dev.mustr.mustr.png"
            out.parent.mkdir(parents=True, exist_ok=True)
            rendered(full_svg, size).save(out)
        scalable = RESOURCES / "linux" / "hicolor" / "scalable" / "apps" / "dev.mustr.mustr.svg"
        scalable.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(full_svg, scalable)

        # Windows.
        ico = [rendered(full_svg, size) for size in ICO_SIZES]
        (RESOURCES / "windows").mkdir(exist_ok=True)
        ico[-1].save(
            RESOURCES / "windows" / "app-icon.ico",
            sizes=[(size, size) for size in ICO_SIZES],
            append_images=ico[:-1],
        )

    print(f"Wrote mustr's icons to {RESOURCES.relative_to(ROOT)}")


if __name__ == "__main__":
    main()
