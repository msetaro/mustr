// mustr's changes to Zed's default settings (assets/settings/default.json).
// mustr deep-merges this file over Zed's defaults at startup, so user
// settings still take precedence.
{
  // Never send usage data or crash reports to Zed.
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  // mustr's agent features come from T3 Code, so Zed's AI is off: the agent
  // panel and its threads, external agents, the inline assistant, edit
  // predictions, Copilot, MCP servers, and Zed's threads sidebar
  // (mustr-docs/ZED-SERVICES.md). `disable_ai` turns off most of it, and user
  // and project settings can't turn it back on. The settings below are off too,
  // for Zed code that reads them without checking `disable_ai`.
  "disable_ai": true,
  "agent": {
    // The threads sidebar reads this directly.
    "enabled": false
  },
  "edit_predictions": {
    "provider": "none"
  },
  "show_edit_predictions": false,
  // mustr never contacts Zed's servers (mustr-docs/ZED-SERVICES.md). Zed's
  // `Client` and the links derived from it use this URL; `.invalid` never
  // resolves, and mustr's HTTP client refuses it before any DNS lookup.
  "server_url": "https://zed.invalid",
  // mustr doesn't use Zed's updater, which would download Zed releases.
  "auto_update": false,
  // mustr makes no requests to zed.dev, so it doesn't use Zed's extension
  // registry (and doesn't start Zed's extension host). These keep the registry
  // off if the extension host is ever initialized. This file merges into Zed's
  // defaults, so `{}` would keep Zed's auto-installs; each one is turned off by
  // name instead.
  "auto_install_extensions": {
    "html": false
  },
  "suggest_extensions": false,
  "window_title_format": "mustr",
  // The size mustr's mockups are drawn at (mustr-docs/PLAN.md §6). mustr sizes
  // its text and layout in rems of `ui_font_size` (`mustr_ui::tokens::scaled`),
  // so the whole UI scales with it, in the same proportions. Zoom In, Zoom Out,
  // and Reset Zoom (⌘=, ⌘-, ⌘0) change both sizes from here.
  "ui_font_size": 13,
  "buffer_font_size": 13,
  // mustr's title bar shows a tab per open item, so the panes don't.
  "tab_bar": {
    "show": false
  },
  // mustr's own themes (assets/themes/mustr), registered by `mustr_ui::init`.
  "theme": {
    "mode": "dark",
    "light": "mustr Light",
    "dark": "mustr Dark"
  },
  // Reviews show the theme's syntax colors as they are. Zed lightens or darkens
  // text drawn over a highlight to keep it readable, which recolors the changed
  // words in a diff (their word highlights), the ones a reviewer reads most.
  "minimum_contrast_for_highlights": 0,
  // The languages mustr adds (`mustr_languages`) are highlighted, with no
  // language servers. Zed attaches Tailwind's, ESLint's and vtsls's servers to
  // these by name, so they're turned off here.
  "languages": {
    "HTML": { "language_servers": [] },
    "PHP": { "language_servers": [] },
    "Svelte": { "language_servers": [] },
    "Vue.js": { "language_servers": [] }
  }
}
